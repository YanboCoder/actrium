        string? app_url,
        string? app_id,
        i64 visit_time_seconds
    );

    /// Return the SQL LIKE parameter used by native history title search.
    string? core_history_search_title_param(string query);

    /// Return SQL used by native tag repositories.
    CoreTagRepositorySqlInfo core_tag_repository_sql();

    /// Convert a native tag SQL row into the shared tag shape.
    CoreTagInfo core_tag_from_row(CoreTagRowInfo row);

    /// Return ordered bind values for native tag insert.
    sequence<CoreSqlValueInfo> core_tag_insert_params(
        string id,
        string name,
        string? color,
        boolean is_system
    );

    /// Return ordered bind values for native tag update.
    sequence<CoreSqlValueInfo> core_tag_update_params(
        string name,
        string? color,
        string id
    );

    /// Return SQL used by native bookmark repositories.
    CoreBookmarkRepositorySqlInfo core_bookmark_repository_sql();

    /// Convert a native bookmark SQL row into the shared bookmark shape.
    CoreBookmarkInfo core_bookmark_from_row(CoreBookmarkRowInfo row);

    /// Return ordered bind values for native bookmark insert.
    sequence<CoreSqlValueInfo> core_bookmark_insert_params(CoreBookmarkInfo bookmark);

    /// Return ordered bind values for native bookmark update.
    sequence<CoreSqlValueInfo> core_bookmark_update_params(CoreBookmarkInfo bookmark);

    /// Return SQL LIKE parameters used by native bookmark search.
    sequence<string> core_bookmark_search_params(string query);

    /// Return SQL used by native app repositories.
    CoreAppRepositorySqlInfo core_app_repository_sql();

    /// Convert a native installed-app SQL row into the shared installed-app shape.
    CoreInstalledAppInfo? core_installed_app_from_row(CoreInstalledAppRowInfo row);

    /// Return ordered bind values for native installed-app insert.
    [Throws=CoreError]
    sequence<CoreSqlValueInfo> core_installed_app_insert_params(CoreInstalledAppInfo app);

    /// Return ordered bind values for native installed-app update.
    [Throws=CoreError]
    sequence<CoreSqlValueInfo> core_installed_app_update_params(CoreInstalledAppInfo app);

    /// Return SQL LIKE parameters used by native app search.
    sequence<string> core_app_search_params(string query);

    /// Return the canonical runtime app status for live apps.
    string runtime_app_status_alive();

    /// Return the canonical runtime app status for stopped apps.
    string runtime_app_status_dead();

    /// Return the default runtime app status.
    string default_runtime_app_status();

    /// Return the canonical runtime app status string, if `value` is known.
    string? normalize_runtime_app_status(string value);

    /// Convert a persisted active-tab row into the platform active-tab model.
    ActiveTabInfo active_tab_from_row(ActiveTabRowInfo row);

    /// Convert a platform active-tab model into a persisted active-tab row.
    ActiveTabRowInfo active_tab_to_row(ActiveTabInfo tab, i32 sort_order);

    /// Convert active-tab models into persisted rows with stable sort order.
    sequence<ActiveTabRowInfo> active_tab_rows_from_tabs(sequence<ActiveTabInfo> tabs);

    /// Build a normalized runtime tab update patch from native bridge fields.
    RuntimeTabUpdateInfo? runtime_tab_update_from_fields(
        string? tab_id,
        string? title,
        string? icon,
        string? app_url,
        string? status
    );

    /// Return canonical bridge payload keys shared by runtime tab events.
    string runtime_bridge_tab_id_key();
    string runtime_bridge_title_key();
    string runtime_bridge_icon_key();
    string runtime_bridge_app_url_key();
    string runtime_bridge_status_key();
    string runtime_bridge_unread_key();
