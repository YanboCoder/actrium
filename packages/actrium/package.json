{
  "name": "@actrium/runtime",
  "version": "1.0.0",
  "description": "Actrium shared React Native runtime and system applications",
  "main": "index.ts",
  "scripts": {
    "start": "node node_modules/react-native/cli.js start --verbose --reset-cache",
    "log": "bun log-server.ts",
    "dev": "node scripts/dev-start.js",
    "generate:actrium-core-contract": "cargo run -p actrium-core --bin generate-ts-contracts -- src/runtime-host/generated/actriumCoreContract.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:all": "tsc --noEmit",
    "lint:logs": "node scripts/check-logs.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "patch-package && node scripts/patch-react-native-macos.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "askit": "file:../actrium-app-sdk",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-reconciler": "0.31.0",
    "keel": "file:../keel"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-babel-transformer": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@tsconfig/react-native": "^3.0.8",
    "@types/node": "^22.19.3",
    "@types/react": "19.0.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@react-native-macos/virtualized-lists": "^0.81.1",
    "react-native-macos": "0.81.1"
  },
  "private": true
}
