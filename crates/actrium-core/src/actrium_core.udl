[Error]
enum CoreError {
    "InvalidJson",
    "MissingField",
    "UnsupportedContract",
    "ContractTooNew",
    "UnknownSystemAppType",
    "UnknownAppSourceType",
    "InvalidActrActorType",
    "UriSchemeInvalid",
    "UriDomainInvalid",
    "UriLabelInvalid",
    "UriLegacyForm",
    "UriLocalRealmForeign",
    "InvalidInstallationId",
    "AuthorityDescriptorInvalid",
    "RealmProfileInvalid",
    "RealmRetired",
};
