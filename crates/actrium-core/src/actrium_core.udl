    string browser_storage_data_model_json();

    /// Return the shared browser storage sync conflict policy contract.
    string browser_storage_sync_conflict_policy_json();

    /// Return the shared browser storage sync collection merge policy contract.
    string browser_storage_sync_merge_policy_json();

    /// Return the shared browser storage address canonicalization policy contract.
    string browser_storage_address_canonicalization_policy_json();

    /// Canonicalize persisted browser storage addresses in a single batch.
    string browser_storage_canonicalize_addresses_json(string addresses_json);

    /// Return the shared bookmark folder tree integrity policy contract.
    string browser_storage_bookmark_folder_tree_integrity_policy_json();

    /// Build a bookmark folder tree integrity plan in a single batch.
    string browser_storage_bookmark_folder_tree_integrity_plan_json(string folders_json);

    /// Return the shared bookmark restore placement policy contract.
    string browser_storage_bookmark_restore_placement_policy_json();

    /// Build a bookmark restore placement plan in a single batch.
    string browser_storage_bookmark_restore_placement_plan_json(string bookmarks_json);

    /// Return the shared bookmark ownership/source resolution policy contract.
    string browser_storage_bookmark_ownership_policy_json();

    /// Build a bookmark ownership/source resolution plan in a single batch.
    string browser_storage_bookmark_ownership_plan_json(string bookmarks_json);

    /// Return the shared history visit aggregation policy contract.
    string browser_storage_history_visit_aggregation_policy_json();

    /// Build history page aggregates from history visits in a single batch.
    string browser_storage_history_visit_aggregation_plan_json(string visits_json);

    /// Return the shared session tab ordering policy contract.
    string browser_storage_session_tab_ordering_policy_json();

    /// Build a contiguous session tab ordering plan in a single batch.
    string browser_storage_session_tab_ordering_plan_json(string tabs_json);

    /// Build a session tab stable-id normalization plan in a single batch.
    string browser_storage_session_tab_id_plan_json(string tabs_json);

    /// Return the shared session active-tab consistency policy contract.
    string browser_storage_session_active_tab_consistency_policy_json();

    /// Build a session active-tab consistency plan in a single batch.
    string browser_storage_session_active_tab_consistency_plan_json(string sessions_json);

    /// Return the shared history/session retention pruning policy contract.
    string browser_storage_retention_pruning_policy_json();

    /// Build a history/session retention pruning plan in a single batch.
    string browser_storage_retention_pruning_plan_json(string records_json);

    /// Normalize a browser storage sync batch JSON payload.
    string normalize_browser_storage_sync_batch_json(string batch_json);

