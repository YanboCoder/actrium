    string runtime_root_props_is_right_panel_visible_key();

    /// Build a normalized tab unread payload from native bridge fields.
    RuntimeTabUnreadInfo? runtime_tab_unread_from_fields(
        string? tab_id,
        boolean? unread
    );

    /// Build a normalized tab bookmark-status payload from native bridge fields.
    RuntimeTabBookmarkStatusInfo? runtime_tab_bookmark_status_from_fields(
        string? tab_id,
        boolean? marked
    );

    /// Build the native-to-runtime tab bookmark event payload.
    RuntimeTabBookmarkEventInfo runtime_tab_bookmark_event(
        string tab_id,
        boolean is_bookmarked
    );

    /// Build the native-to-runtime tab fullscreen event payload.
    RuntimeTabFullscreenEventInfo runtime_tab_fullscreen_event(string tab_id);

    /// Build the native-to-runtime extension panel visibility event payload.
    RuntimeExtensionPanelVisibleEventInfo runtime_extension_panel_visible_event(
        string tab_id,
        boolean visible
    );

    /// Build the native-to-runtime container size event payload.
    RuntimeContainerSizeChangeEventInfo runtime_container_size_change_event(
        i32 container_width,
        i32 container_height
    );

    /// Convert an active-tab model into the React Native runtime tab props shape.
    RuntimeTabInfo runtime_tab_from_active_tab(ActiveTabInfo tab);

    /// Build single-tab React Native runtime root props from active-tab models.
    RuntimeRootPropsInfo runtime_root_props_from_active_tabs(
        ActiveTabInfo tab,
        sequence<ActiveTabInfo> tabs,
        i32 container_height,
        i32 container_width
    );

    /// Build single-tab React Native runtime root props from prebuilt runtime tabs.
    RuntimeRootPropsInfo runtime_root_props_from_runtime_tabs(
        RuntimeTabInfo tab,
        sequence<RuntimeTabInfo> tabs,
        boolean is_left_panel_visible,
        boolean is_right_panel_visible,
        i32 container_height,
        i32 container_width,
        string? app_url
    );

    /// Build the current Android-compatible single system page root props.
    [Throws=CoreError]
    RuntimeSystemRootPropsInfo runtime_system_root_props(string system_app_type);

    /// Return the canonical ActrBridge native module/event/payload contract.
    ActrBridgeContractInfo actr_bridge_contract();

    /// Parse an Actor type in `publisher/program@version` form.
    [Throws=CoreError]
    ActrActorTypeInfo parse_actr_actor_type(string raw);

    /// Map a BCP-47-ish ASR language code to an available bundled model dir.
    string asr_model_language_dir(string language);

    /// Build the platform ASR model loading path plan for a language.
    AsrModelPlanInfo asr_model_plan(string language);

    /// Return the canonical Android ASR native module/event/payload contract.
    AsrBridgeContractInfo asr_bridge_contract();

    /// Return the canonical TTS native module/event/options/payload contract.
    TtsBridgeContractInfo tts_bridge_contract();

    /// Return the canonical Email native module/method/error contract.
    EmailBridgeContractInfo email_bridge_contract();

    /// Return the canonical UserInfo native module/method/event/payload contract.
    UserInfoBridgeContractInfo user_info_bridge_contract();

    /// Parse Vosk getResult/getFinalResult JSON and return the `text` field.
    string parse_vosk_result_text(string json);

    /// Parse Vosk getPartialResult JSON and return the `partial` field.
    string parse_vosk_partial_text(string json);

    /// Build final Chinese ASR text from platform-provided segmentation terms.
    string post_process_zh_asr_segments(
        string text,
        sequence<AsrSegmentInfo> segments
    );
};

dictionary ActrPackageManifestInfo {
    string name;
    string version;
    string? description;
    string? app_id;
    string? icon;
    string entry;
    boolean left_panel_default_visible;
    boolean right_panel_default_visible;
    string? contract_name;
    u32? contract_version;
    sequence<string> permissions;
    string? system_app_type;
    string? theme_color;
};

/// Parsed `actr://` Realm link or Actor address.
dictionary ActrUriInfo {
    /// Lowercase IDNA A-label domain, or `<installation-id>.actr.alt`.
    string domain;
    string? realm_id;
    string? serial;
    /// Whether the link targets this installation's local Realm.
    boolean is_local;
    /// `https://<domain>/.well-known/actr`; null for a local Realm.
    string? discovery_url;
};

/// A trusted realm signing key from an accepted authority descriptor.
dictionary RealmSigningKeyInfo {
    string id;
    /// Base64 Ed25519 public key, as listed by the descriptor.
    string public_key_base64;
    /// `active` or `retired`.
    string status;
};

/// Validated authority descriptor for a Realm domain.
dictionary AuthorityDiscoveryInfo {
    /// Realms service href; Realm Profile GETs append `/<realm_id>`.
    string realms_href;
    /// Sequence of the accepted `realm_signing_keys` member.
    u64 keys_sequence;
    sequence<RealmSigningKeyInfo> signing_keys;
    /// The accepted member serialized; pass back to `accept_realm_profile`.
    string signing_keys_json;
};

/// A verified Realm Profile: the package target and endpoints that feed
/// package acquisition.
dictionary RealmProfileInfo {
    /// Canonical Realm name `<realm_id>@<domain>`.
    string realm_name;
    string display_name;
    /// Always `active`; retired Realms are rejected.
    string status;
    u64 sequence;
    /// HTTPS download URL of the signed `.actr` package.
    string package_href;
    /// Lowercase hex SHA-256 the package must match.
    string package_sha256;
    /// Actor type `publisher/program@version`.
    string package_type;
    /// Issuer endpoint that serves Actor credentials.
    string issuer_url;
};

/// A package signing key from a verified Publisher Profile.
dictionary PublisherPackageKeyInfo {
    /// `actr-pub-` + 16 lowercase hex characters of the key digest.
    string id;
    /// Base64 Ed25519 public key.
    string public_key_base64;
    /// `active` or `retired`.
    string status;
};

/// Verified Publisher Profile for a publisher domain.
dictionary PublisherProfileInfo {
    string domain;
    u64 profile_sequence;
    /// RFC 3339; past this point the profile must be re-fetched.
    string profile_expires_at;
    sequence<PublisherPackageKeyInfo> package_signing_keys;
};

