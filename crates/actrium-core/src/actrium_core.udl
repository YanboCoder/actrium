namespace actrium_core {
    /// Parse and validate an actr-package/2 TOML manifest.
    [Throws=CoreError]
    ActrPackageManifestInfo parse_actr_package_manifest(string source);

    /// Validate an actr-package/2 TOML manifest without returning normalized fields.
    [Throws=CoreError]
    void validate_actr_package_manifest(string source);

    /// Generate a fresh installation id: 26 lowercase base32 characters
    /// from 16 OS-CSPRNG bytes. Platforms persist the value once and own
    /// the storage.
    string generate_installation_id();

    /// Validate an installation id against the `.actr.alt` domain rules.
    [Throws=CoreError]
    void validate_installation_id(string id);

    /// Parse and validate an `actr://` Realm link or Actor address.
    ///
    /// Layer-0 verification-funnel step: zero network. Delegates to
    /// `realm_link::open_realm_link`; `installation_id` is this
    /// installation's local Realm id (26 lowercase base32 characters).
    [Throws=CoreError]
    ActrUriInfo parse_actr_uri(string uri, string installation_id);

    /// Validate an authority descriptor response for `domain` and extract
    /// the trusted realm signing keys plus the realms service href.
    ///
    /// `body` is the raw JSON text as received over HTTPS. Key pinning
    /// across visits is not applied yet.
    [Throws=CoreError]
    AuthorityDiscoveryInfo accept_authority_descriptor(string body, string domain);

    /// Validate a Realm Profile response for `realm_name` and extract the
    /// package target.
    ///
    /// `body` is the raw JSON text as received; `signing_keys_json` is the
    /// `signingKeysJson` output of `accept_authority_descriptor`. Retired
    /// Realms are rejected.
    [Throws=CoreError]
    RealmProfileInfo accept_realm_profile(string body, string realm_name, string signing_keys_json);

    /// Validate the descriptor served by a publisher domain and verify its
    /// inline Publisher Profile; extract the package signing keys that
    /// verify the `.actr` package signature.
    [Throws=CoreError]
    PublisherProfileInfo accept_publisher_profile(string body, string domain);

    /// Evaluate a contract tuple using the current Actrium host compatibility rules.
    ContractGateInfo evaluate_contract(string? name, u32 version);

    /// Extract the app id from URLs containing `/with/{appId}`.
    string? extract_app_id_from_url(string url);

    /// Collapse repeated slashes in a filesystem-like path.
    string normalize_path(string path);

    /// Return a normalized relative path from `base_dir` to `absolute_path`.
    string relative_path_from(string absolute_path, string base_dir);

    /// Return whether the path points to a known ACTR asset extension.
    boolean is_asset_path(string path);

    /// Normalize and validate a manifest integrity algorithm.
    string? normalize_integrity_algorithm(string raw);

    /// Normalize and validate a manifest integrity file path.
    string? normalize_integrity_path(string path);

    /// Normalize and validate a SHA-256 hex digest.
    string? normalize_sha256_hex(string hash);

    /// Build the stable 16-character content fingerprint used by host shells.
    string stable_content_fingerprint(string input);

    /// Build the payload integrity verification plan from a TOML manifest.
    [Throws=CoreError]
    PackageIntegrityPlanInfo? create_actr_integrity_plan(string manifest_toml);

    /// Parse a system app type into the canonical wire string, if known.
    string? parse_system_app_type(string raw);

    /// Return title and about: URL metadata for a system app type.
    [Throws=CoreError]
    SystemAppInfo system_app_info(string raw);

    /// Return the canonical bookmarks system app type.
    string system_app_type_bookmarks();

    /// Return the canonical settings system app type.
    string system_app_type_settings();

    /// Return the canonical global search system app type.
    string system_app_type_global_search();

    /// Parse an app source type into the canonical wire string, if known.
    string? parse_app_source_type(string raw);

    /// Return display metadata for an app source type.
    [Throws=CoreError]
    AppSourceTypeInfo app_source_type_info(string raw);

    /// Return the canonical downloaded app source type.
    string app_source_type_downloaded();

    /// Return the canonical local development app source type.
    string app_source_type_local_dev();

    /// Return the canonical default browser search engine id.
    string browser_search_engine_default_id();

    /// Return supported browser search engines.
    sequence<BrowserSearchEngineInfo> browser_search_engines();

    /// Return metadata for a browser search engine, falling back to the default.
    BrowserSearchEngineInfo browser_search_engine_info(string? engine_id);

    /// Normalize a browser search engine id, falling back to the default.
    string browser_search_engine_normalize_id(string? engine_id);

    /// Build the browser search URL for a query and search engine.
    string browser_search_url(string query, string? engine_id);

    /// Return the shared browser data snapshot contract.
    BrowserDataContractInfo browser_data_contract();

    /// Normalize a browser history snapshot JSON document.
    string browser_history_snapshot_normalize_json(string snapshot_json);

    /// Normalize a browser bookmark snapshot JSON document.
    string browser_bookmark_snapshot_normalize_json(string snapshot_json);

    /// Normalize a browser session snapshot JSON document.
    string browser_session_snapshot_normalize_json(string snapshot_json);

    /// Return the default browser session snapshot JSON document.
    string browser_session_home_snapshot_json();

    /// Return the shared browser storage schema contract.
    BrowserStorageSchemaInfo browser_storage_schema();

    /// Return the shared browser storage schema version.
    u32 browser_storage_schema_version();

    /// Return the shared browser storage database name.
    string browser_storage_database_name();

    /// Return SQL statements for the shared browser storage schema.
    sequence<string> browser_storage_schema_statements();

    /// Return the shared browser storage incremental schema migration plan JSON.
    string browser_storage_schema_migration_plan_json();

    /// Return table names for the shared browser storage schema.
    sequence<string> browser_storage_table_names();

    /// Return shared browser storage repository SQL.
    BrowserStorageRepositorySqlInfo browser_storage_repository_sql();

    /// Return shared browser storage sync SQL.
    BrowserStorageSyncSqlInfo browser_storage_sync_sql();

